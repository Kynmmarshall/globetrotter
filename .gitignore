# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/
npm-debug.log*

# Env and secrets
.env
.env.*
!.env.example
*.pem
*.key
!infra/keys/.gitkeep

# Data and uploads
backend/monolith/data/db.json
backend/microservice/user_service/data/db.json
backend/microservice/recommendation_service/data/db.json
backend/microservice/itinerary_service/data/db.json
