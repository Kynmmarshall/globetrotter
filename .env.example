# Shared
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Gateway (the only container that publishes a port to the host)
GATEWAY_PORT=8090

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=globetrotter
RABBITMQ_PASSWORD=change-me-in-local-env
RABBITMQ_MANAGEMENT_PORT=15672

# JWT (RS256 keypair, generated by scripts/generate_jwt_keys.py)
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key.pem
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
JWT_ISSUER=globetrotter-user-service

# Cookies / CSRF
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Internal service-to-service auth
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# Directions provider (public OSRM demo server; replace with self-hosted OSRM in production)
OSRM_BASE_URL=https://router.project-osrm.org

# Frontend
VITE_API_BASE_URL=/api/v1
VITE_WS_CHAT_URL=/ws/chat
