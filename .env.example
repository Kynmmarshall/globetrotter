# Shared
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Gateway (the only container that publishes a port to the host)
GATEWAY_PORT=8090
# Interface the gateway's port is published on. Leave as 0.0.0.0 for local
# dev. In production (behind a host-level nginx + TLS), set this to
# 127.0.0.1 so the gateway is reachable only from that reverse proxy.
GATEWAY_BIND_HOST=0.0.0.0

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=globetrotter
RABBITMQ_PASSWORD=change-me-in-local-env
RABBITMQ_MANAGEMENT_PORT=15672
# Same idea as GATEWAY_BIND_HOST: set to 127.0.0.1 in production so RabbitMQ's
# AMQP port and management UI aren't reachable from the public internet.
RABBITMQ_BIND_HOST=0.0.0.0

# JWT (RS256 keypair, generated by scripts/generate_jwt_keys.py)
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key.pem
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
JWT_ISSUER=globetrotter-user-service

# Cookies / CSRF
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Allowed browser origins for CORS and the chat WebSocket's origin check.
# Must be a JSON array string. In production, set this to your public
# origin(s) only, e.g. CORS_ORIGINS=["https://your-domain.example"]
CORS_ORIGINS=["http://localhost:8090", "http://localhost:5173"]

# Internal service-to-service auth
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# Directions provider (public OSRM demo server; replace with self-hosted OSRM in production)
OSRM_BASE_URL=https://router.project-osrm.org

# Frontend
VITE_API_BASE_URL=/api/v1
VITE_WS_CHAT_URL=/ws/chat
